# 只含非敏感配置；两文件凭据必须属于独立账号与专用prefix。
BACKUP_REPLICA_ENABLED=true
BACKUP_REPLICA_S3_ENDPOINT=https://replica-storage.example.invalid
BACKUP_REPLICA_S3_REGION=us-east-1
BACKUP_REPLICA_S3_PREFIX=s3://replica-backups/unique-cluster/pg17
BACKUP_REPLICA_S3_FORCE_PATH_STYLE=true
BACKUP_REPLICA_CA_FILE=./certs/replica-ca.crt
BACKUP_REPLICA_INTERVAL_SECONDS=300
# 至少为间隔的3倍，并覆盖一次完整同步耗时、verify及调度余量；不是恢复RPO承诺。
BACKUP_REPLICA_MAX_AGE_SECONDS=3600
BACKUP_REPLICA_NETWORK_RATE_LIMIT=10485760
