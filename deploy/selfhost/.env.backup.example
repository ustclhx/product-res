# 显式 -f compose.yaml -f compose.backup.yaml；只有PG/backup获得这两份独立备份密钥。
BACKUP_IMAGE=ghcr.io/configure-owner/product-res/backup:<full-40-character-sha>
BACKUP_S3_ENDPOINT=https://s3.example.com
BACKUP_S3_REGION=us-east-1
BACKUP_S3_PREFIX=s3://product-res-backups/<unique-cluster-id>/pg17
BACKUP_S3_FORCE_PATH_STYLE=true
# 公共HTTPS可用系统CA bundle；私有HTTPS用受信CA/bundle。禁止关闭证书校验。
BACKUP_CA_FILE=./certs/backup-ca.crt
BACKUP_UTC_TIME=02:00
BACKUP_ARCHIVE_TIMEOUT_SECONDS=60
BACKUP_DAILY_DAYS=7
BACKUP_WEEKLY_WEEKS=4
# 0=周一，6=周日；固定UTC锚点。
BACKUP_WEEKLY_DAY=0
BACKUP_DISK_RATE_LIMIT=10485760
BACKUP_NETWORK_RATE_LIMIT=10485760
BACKUP_MIN_FREE_BYTES=134217728
BACKUP_RETRY_SECONDS=300
