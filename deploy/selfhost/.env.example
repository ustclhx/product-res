# 只拉取受信CI发布的同SHA镜像；deploy.sh将全部_IMAGE固定到bundle中的digest。
# 占位符不可直接部署；从项目自己的成功发布取得bundle，不在服务器运行build.sh。
IMAGE_NAMESPACE=ghcr.io/ustclhx/product-res
COMPOSE_PROJECT_NAME=product-res-selfhost
WEB_IMAGE=ghcr.io/ustclhx/product-res/web:<full-40-character-sha>
JOBS_IMAGE=ghcr.io/ustclhx/product-res/jobs:<full-40-character-sha>
MIGRATE_IMAGE=ghcr.io/ustclhx/product-res/migrate:<full-40-character-sha>
POSTGRES_IMAGE=ghcr.io/ustclhx/product-res/postgres:<full-40-character-sha>
VALKEY_IMAGE=ghcr.io/ustclhx/product-res/valkey:<full-40-character-sha>
CADDY_IMAGE=ghcr.io/ustclhx/product-res/caddy:<full-40-character-sha>
BACKUP_IMAGE=ghcr.io/ustclhx/product-res/backup:<full-40-character-sha>
OBJECT_STORAGE_IMAGE=ghcr.io/ustclhx/product-res/object-storage:<full-40-character-sha>
# 仅加载 compose.tunnel.yaml 时使用；默认 Caddy 直连不启动 cloudflared。
CLOUDFLARED_IMAGE=ghcr.io/ustclhx/product-res/cloudflared:<full-40-character-sha>
COMPOSE_PROFILES=caddy
APP_DOMAIN=product.ezarouter.cc
APP_URL=https://product.ezarouter.cc
ACME_EMAIL=hxl15380@gmail.com
CADDY_TLS_MODE=acme
CADDY_CERT_DIR=./certs/caddy
PG_TLS_DIR=./certs/postgres
CA_FILE=./certs/ca.crt
SECRETS_DIR=./secrets
POSTGRES_DB=product_res_production
CACHE_NAMESPACE=product-res-production
DB_POOL_MAX=10
# 同时固定 jobs hostname 与 executor ID；跨重启保留，双副本需各自不同的稳定值并共享 owner 卷。
JOB_EXECUTOR_ID=jobs-1
SHUTDOWN_TIMEOUT_MS=30000
# 只信任此专用 ingress 上的 Caddy；外部代理接入后改成其确切IP/CIDR。
# Tunnel 模式由 compose.tunnel.yaml 固定为 cloudflared 的 172.30.77.6/32，此值不生效。
TRUSTED_PROXY_CIDRS=172.30.77.2/32
EMAIL_TRANSPORT=log
# 首个管理员（注册后自动提升）与注册白名单，逗号分隔；白名单留空表示任何人可注册
BOOTSTRAP_ADMIN_EMAILS=
SIGNUP_ALLOWED_EMAILS=
LOG_MAX_SIZE=10m
LOG_MAX_FILE=3

# 可选override的公开占位值；启用时另行提供受限S3 secrets/CA。
BACKUP_S3_ENDPOINT=https://backup.example.com
BACKUP_S3_PREFIX=s3://backup-example/cluster/pg17
S3_PUBLIC_DOMAIN=s3.example.com
# 仅加载 compose.s3.yaml 时传给应用；region 必须显式填写，R2 使用 auto。
# R2 endpoint 使用 https://<account-id>.r2.cloudflarestorage.com，不能用 r2.dev/自定义下载域名。
S3_ENDPOINT=https://s3.example.com
S3_REGION=us-east-1
S3_BUCKET=files
S3_FORCE_PATH_STYLE=true
