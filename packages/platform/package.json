{
  "name": "@product-res/platform",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cloudflare": "./src/cloudflare/index.ts",
    "./node": "./src/node/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.cloudflare.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:node:integration": "vitest run --config vitest.node-integration.config.ts",
    "dbos:migrate": "node --experimental-strip-types src/node/job-engine-migrate.ts",
    "test:job-engine": "vitest run --config vitest.job-engine.config.ts"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "5.2.11",
    "@product-res/db": "workspace:*",
    "@product-res/shared": "workspace:*",
    "cron-parser": "5.4.0",
    "drizzle-orm": "^0.45.3",
    "ioredis": "5.8.2",
    "pg": "8.20.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.5",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@types/node": "^22.20.5",
    "@types/pg": "8.20.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  }
}
