{
  "name": "@product-res/storage",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./cloudflare": "./src/cloudflare/index.ts",
    "./node": "./src/node/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.cloudflare.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "test:node:s3": "vitest run --config vitest.node-s3.config.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1149.0",
    "@aws-sdk/lib-storage": "3.1149.0",
    "@aws-sdk/s3-request-presigner": "3.1149.0",
    "@product-res/auth": "workspace:*",
    "@product-res/db": "workspace:*",
    "@product-res/entitlements": "workspace:*",
    "@product-res/shared": "workspace:*",
    "aws4fetch": "^1.0.20",
    "drizzle-orm": "^0.45.3"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.5",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@types/node": "^22.20.5",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  }
}
