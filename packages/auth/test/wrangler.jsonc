// 仅供 vitest-plugin 集成测试使用的 Worker 配置（compatibility_date 受限于其自带的 workerd 版本）。
// HYPERDRIVE 的本地连接串由 vitest.config.ts 通过
// CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE 提供（取自 .env.worktree）；
// 不可达的 HYPERDRIVE_REFUSED 由 vitest.config.ts 添加。KV 与 Rate Limiting 由 Miniflare 在本地模拟。
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "product-res-auth-test",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "hyperdrive": [{ "binding": "HYPERDRIVE", "id": "00000000000000000000000000000000" }],
  "kv_namespaces": [
    { "binding": "CACHE", "id": "test-cache" },
    // 始终为空的 KV：对照组（KV 未命中时回退查库）
    { "binding": "CACHE_EMPTY", "id": "test-cache-empty" }
  ],
  // 每个 key 每 60 秒 5 次；测试中每个场景使用独立的 IP 与邮箱，互不影响
  "ratelimits": [
    { "name": "RL_AUTH", "namespace_id": "1001", "simple": { "limit": 5, "period": 60 } }
  ]
}
