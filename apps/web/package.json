{
  "name": "@product-res/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "deploy:staging": "CLOUDFLARE_ENV=staging vite build && wrangler deploy",
    "preview": "vite preview",
    "typecheck": "node scripts/generate-route-tree.mjs && node scripts/compile-messages.mjs && node scripts/build-content.mjs && tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json && tsc -p tsconfig.neutral.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:smoke": "playwright test -c playwright.smoke.config.ts",
    "test:e2e:stripe": "playwright test -c playwright.stripe.config.ts",
    "build:node": "vite build --config vite.node.config.ts && node scripts/build-node-bootstrap.mjs",
    "start:node": "node .output/server/index.mjs",
    "test:node": "node scripts/test-node.mjs",
    "test:node:production": "vitest run --config vitest.production.node.config.ts",
    "test:node:storage": "node scripts/test-node-storage.mjs"
  },
  "dependencies": {
    "@ai-sdk/react": "^4.0.130",
    "@fontsource-variable/inter": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@product-res/ai": "workspace:*",
    "@product-res/auth": "workspace:*",
    "@product-res/billing": "workspace:*",
    "@product-res/config": "workspace:*",
    "@product-res/connectors": "workspace:*",
    "@product-res/costing": "workspace:*",
    "@product-res/credits": "workspace:*",
    "@product-res/datasources": "workspace:*",
    "@product-res/db": "workspace:*",
    "@product-res/email": "workspace:*",
    "@product-res/entitlements": "workspace:*",
    "@product-res/marketdata": "workspace:*",
    "@product-res/platform": "workspace:*",
    "@product-res/shared": "workspace:*",
    "@product-res/storage": "workspace:*",
    "@product-res/ui": "workspace:*",
    "@sentry/cloudflare": "^11.6.0",
    "@sentry/node": "11.6.0",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-router": "^1.170.41",
    "@tanstack/react-start": "^1.168.60",
    "ai": "^7.0.127",
    "better-auth": "^1.7.7",
    "drizzle-orm": "^0.45.3",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.4",
    "@cloudflare/vitest-plugin": "1.3.5",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@content-collections/core": "^0.15.3",
    "@content-collections/mdx": "^0.2.2",
    "@content-collections/vite": "^0.3.1",
    "@inlang/paraglide-js": "^2.25.4",
    "@inlang/plugin-message-format": "^4.4.4",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "cf-workers-og": "3.0.1",
    "esbuild": "^0.28.2",
    "nitro": "3.0.260903-beta",
    "openai": "^7.28.0",
    "postgres": "^3.4.9",
    "srvx": "1.0.5",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  }
}
