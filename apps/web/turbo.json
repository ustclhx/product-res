{
  "$schema": "https://turborepo.com/schema.json",
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["$TURBO_EXTENDS$", "!dist/**/.dev.vars"]
    },
    "test": {
      // web 与 jobs 的集成测试读写同一个 jobs.lastCronAt 键，串行运行避免互相覆盖
      "dependsOn": ["$TURBO_EXTENDS$", "@product-res/jobs#test"],
      "cache": false,
      "passThroughEnv": [
        "CI",
        "CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE",
        "MIGRATION_DATABASE_URL"
      ]
    },
    "dev": {
      "passThroughEnv": [
        "CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE",
        "CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE_CACHED",
        "STRIPE_SECRET_KEY",
        "STRIPE_WEBHOOK_SECRET",
        "PAYPAL_CLIENT_ID",
        "PAYPAL_CLIENT_SECRET",
        "PAYPAL_WEBHOOK_ID"
      ]
    }
  }
}
