{
  "name": "@product-res/jobs",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "wrangler deploy --dry-run --outdir dist",
    "deploy:staging": "wrangler deploy --env staging",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.node.json",
    "test": "vitest run",
    "build:node": "node scripts/build-node.mjs",
    "start:node": "node .output/server/index.mjs",
    "test:node": "vitest run --config vitest.unit.config.ts",
    "test:node:integration": "vitest run --config vitest.node-integration.config.ts",
    "test:node:smtp": "node test/run-node-integration.mjs"
  },
  "dependencies": {
    "@dbos-inc/dbos-sdk": "5.2.11",
    "@product-res/ai": "workspace:*",
    "@product-res/auth": "workspace:*",
    "@product-res/billing": "workspace:*",
    "@product-res/config": "workspace:*",
    "@product-res/connectors": "workspace:*",
    "@product-res/datasources": "workspace:*",
    "@product-res/db": "workspace:*",
    "@product-res/email": "workspace:*",
    "@product-res/entitlements": "workspace:*",
    "@product-res/follow": "workspace:*",
    "@product-res/marketdata": "workspace:*",
    "@product-res/platform": "workspace:*",
    "@product-res/shared": "workspace:*",
    "@product-res/storage": "workspace:*",
    "@sentry/cloudflare": "^11.6.0",
    "@sentry/node": "11.6.0",
    "cron-parser": "5.4.0",
    "drizzle-orm": "^0.45.3",
    "ioredis": "5.8.2",
    "pg": "8.20.0",
    "postgres": "^3.4.9",
    "uuid": "^14.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.5",
    "@cloudflare/workers-types": "^5.20261002.1",
    "@product-res/credits": "workspace:*",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.146.0"
  }
}
