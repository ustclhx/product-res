# Copy to .env.local and enter test/sandbox credentials only.
# Stripe: sk_test_...; local listener signing secret: whsec_...
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# PayPal: Sandbox REST App credentials and local endpoint Webhook ID.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Required by billing:sync. Live/production sync is not supported.
BILLING_SYNC_MODE=test
# Optional explicit billing database target; otherwise use .env.worktree.
CLOUDFLARE_HYPERDRIVE_LOCAL_CONNECTION_STRING_HYPERDRIVE=
